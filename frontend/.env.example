VITE_CHAIN_ID=31337             # 1874 on Whitechain Sepolia (the default when unset)
VITE_RPC_URL=http://127.0.0.1:8545   # leave unset to use the chain's public RPC
VITE_BACKEND_URL=http://localhost:8787   # leave unset to skip the backend check
VITE_WORLD_APP_ID=   # leave unset to turn World ID off, so only an Admin adds investors
VITE_WORLD_ENVIRONMENT=staging   # staging for the World ID simulator, production for real World IDs
