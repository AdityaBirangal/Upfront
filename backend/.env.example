# PORT is reserved on Firebase. Local dev defaults to 8787; override with PORT=... npm run start:dev
# 1874 on Whitechain Sepolia
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# read from deployments.json if empty
UPFRONT_ADDRESS=
ACCESS_ADDRESS=
ALLOWED_ORIGIN=http://localhost:5173,https://upfront.web.app,https://eth-global-c6363.web.app
DATA_DIR=./data
MAX_UPLOAD_BYTES=5242880
# disk for local dev; .env.eth-global-c6363 sets firebase for the deployed function
STORAGE=disk
# Uploads allowed per client IP in each window
UPLOAD_RATE_LIMIT=20
UPLOAD_RATE_WINDOW_SECONDS=600
# Proxies to trust for x-forwarded-for: 1 on Cloud Functions, 0 to use the socket address
TRUST_PROXY_HOPS=1
# World ID. Leave these empty to turn it off: everything else keeps working.
WORLD_RP_ID=
# staging for the World ID simulator, production for real World IDs
WORLD_ENVIRONMENT=staging
# Optional. Defaults to join-investors. Nullifiers are per action, so changing it starts them fresh.
WORLD_ACTION=
# Secrets. On Firebase, set them with `firebase functions:secrets:set`, never in an env file.
GATE_SIGNER_KEY=
RP_SIGNING_KEY=
